<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.0/dist/tailwind.min.css" rel="stylesheet">
    <title>User Registration</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cantora+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cantora+One&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <style>
        .cantora-one-regular {
            font-family: "Cantora One", serif;
            font-weight: 600;
            font-style: normal;
        }  

        .color {
            color: #c31432;
        }

        .bg-color {
            background-color: #c31432;
        }

        input:focus {
            border-color: #d3a3a9;
            border-width: 1.5px;  /* Ensures the border is visible */
            outline: none;  /* Removes the default blue outline */
        }

        /* Responsive Styling */
        @media (max-width: 480px) {
            body {
                height: 85vh;
            }
            form {
                width: 95%;
                padding: 15px;
            }
        }

        @media (min-width: 1024px) {
            form {
                max-width: 450px;
                padding: 30px;
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
            }
        }
    </style>
</head>
<body class="bg-gray-100 flex items-center justify-center px-4 mt-4">

<form action="/api/user/signup" method="post" class="w-full max-w-md bg-white p-6 border border-gray-200 rounded-lg shadow-lg">
    <h1 class="text-2xl color font-bold text-center text-gray-800 cantora-one-regular mb-1">Create Your Account</h1>
    <h4 class="text-center text-gray-600 text-sm mb-4">Please enter details to register</h4>

    <!-- Flash Messages -->
    <% if (successMessage && successMessage.length > 0) { %>
        <div class="mb-4 p-4 text-sm text-green-700 bg-green-100 rounded-lg" role="alert">
            <%= successMessage %>
        </div>
    <% } %>

    <% if (errorMessage && errorMessage.length > 0) { %>
        <div class="mb-4 p-4 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
            <%= errorMessage %>
        </div>
    <% } %>

    <!-- Name Field -->
    <div class="mb-3">
        <label for="name" class="block mb-2 text-sm font-medium text-gray-900">Full Name</label>
        <input type="text" id="name" name="name" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-500 focus:block w-full p-2 mb-5" required />
    </div>

    <!-- Email Field -->
    <div class="mb-3">
        <label for="email" class="block mb-2 text-sm font-medium text-gray-900">Email Address</label>
        <input type="email" id="email" name="email" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-500 focus:block w-full p-2 mb-5" placeholder="name@domain.com" required />
    </div>

    <!-- Phone Number with Country Code -->
    <div class="mb-3">
        <label for="phone" class="block text-sm font-medium text-gray-900 whitespace-nowrap">Phone Number</label>
        <br>
        <div class="flex space-x-2 w-full mb-5" style="margin-top: -15px;">
            <select id="country_code" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-500 focus:w-20 p-2" name="country_code" required>
                <option value="+968">+968</option>
            </select>
            <input type="tel" id="phone" name="phone" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-500 focus:block w-full p-2 " placeholder="123-456-7890" required />
        </div>
    </div>

    <!-- Password Field -->
    <div class="mb-3">
        <label for="password" class="block mb-2 text-sm font-medium text-gray-900">Create Password</label>
        <input type="password" id="password" name="password" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-500 focus:block w-full p-2 mb-5" required />
    </div>

    <div class="mb-3">
        <label for="confirmPassword" class="block mb-2 text-sm font-medium text-gray-900">Re-enter Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-red-500 focus:block w-full p-2 mb-3" required />
    </div>

    <!-- Terms and Conditions -->
    <div class="mb-3 flex items-center">
        <input id="terms" type="checkbox" class="ml-2 w-3 h-3 text-red-600 border-gray-300 rounded focus:ring-2 focus:ring-red-500" required />
        <label for="terms" class="ml-2 text-sm text-gray-900" style="font-size: 12.5px;">I have read and agree to the Terms & Conditions</a></label>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="text-white bg-color hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm w-1/2 px-4 py-2.5 text-center" style="margin-left: 90px;">Submit</button>
    <p class="mt-4 text-center text-sm text-gray-600">
        Already have an account? <a href="/api/user/login" class="text-red-600 hover:underline">Login</a>
    </p>
</form>

<script src="../keepAlive.js"></script>
</body>
</html>
