<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.0/dist/tailwind.min.css" rel="stylesheet">
    <title>Admin - Payment Requests</title>
    <style>
         body {
    font-family: 'Poppins', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100 text-gray-800">

    <nav class="bg-white shadow-md py-4">
        <div class="container mx-auto px-6 flex justify-between items-center">
            <h1 class="text-2xl font-bold text-gray-800">Logo</h1>
            <div class="flex space-x-4 items-center">
                <a href="/admin/loans" class="text-gray-700 hover:text-green-600 font-medium">Loan Requests</a>
                <span class="text-gray-300">|</span>
                <a href="/admin/loans/approve" class="text-gray-700 hover:text-yellow-600 font-medium">Approved Loans</a>
                <span class="text-gray-300">|</span>
                <a href="/admin/loans/decline" class="text-gray-700 hover:text-gray-600 font-medium">Declined Loans</a>
                <span class="text-gray-300">|</span>
                <a href="/admin/payment-requests" class="text-gray-700 hover:text-purple-600 font-medium">Payment Requests</a>
            </div>

            <!-- View Users & Logout Box -->
            <div class="border border-gray-300 px-4 py-2 rounded-md flex items-center space-x-4 bg-gray-50">
                <a href="/admin/users" class="text-gray-700 hover:text-blue-600 font-medium">View Users</a>
                <span class="text-gray-300">|</span>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="bg-red-500 hover:bg-red-600 text-white text-sm font-medium py-2 px-4 rounded shadow transition">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </nav>
    
    <!-- Navbar -->
   
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold text-blue-600">Admin - Payment Requests</h1>
            <a href="/admin/" class="bg-blue-500 hover:bg-blue-600 text-white text-sm font-medium py-2 px-4 rounded shadow">
                Back to Dashboard
            </a>
        </div>
    

    <!-- Flash Messages -->
    <main class="container mx-auto px-6 py-10">
        <% if (successMessage && successMessage.length > 0) { %>
            <div class="mb-4 p-4 text-sm text-green-700 bg-green-100 rounded-lg" role="alert">
                <%= successMessage %>
            </div>
        <% } %>
        <% if (errorMessage && errorMessage.length > 0) { %>
            <div class="mb-4 p-4 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
                <%= errorMessage %>
            </div>
        <% } %>

        <h2 class="text-3xl font-semibold text-gray-700 mb-6">Manage Payment Requests</h2>

        <!-- Payment Requests Table -->
        <div class="bg-white shadow-lg rounded-lg overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="py-3 px-6 text-left text-sm font-medium text-gray-600 uppercase tracking-wider">Username</th>
                        <th class="py-3 px-6 text-left text-sm font-medium text-gray-600 uppercase tracking-wider">EMI Plan</th>
                        <th class="py-3 px-6 text-left text-sm font-medium text-gray-600 uppercase tracking-wider">Total Cost</th>
                        <th class="py-3 px-6 text-left text-sm font-medium text-gray-600 uppercase tracking-wider">Payment Status</th>
                        <th class="py-3 px-6 text-center text-sm font-medium text-gray-600 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <% paymentRequests.forEach(request => { %>
                        <tr>
                            <td class="py-4 px-6 text-sm text-gray-700"><%= request.studentName %></td>
                            <td class="py-4 px-6 text-sm text-gray-700"><%= request.emiPlan %> months</td>
                            <td class="py-4 px-6 text-sm text-gray-700">$<%= request.totalCost.toFixed(2) %></td>
                            <td class="py-4 px-6 text-sm">
                                <% if (request.paymentStatus === 'Pending') { %>
                                    <span class="px-3 py-1 rounded-full text-sm bg-yellow-100 text-yellow-800">Pending</span>
                                <% } else if (request.paymentStatus === 'Approved') { %>
                                    <span class="px-3 py-1 rounded-full text-sm bg-green-100 text-green-800">Approved</span>
                                <% } else { %>
                                    <span class="px-3 py-1 rounded-full text-sm bg-red-100 text-red-800">Declined</span>
                                <% } %>
                            </td>
                            <td class="py-4 px-6 text-center">
                                <div class="flex justify-center space-x-2">
                                    <form action="/admin/payments/approve/<%= request._id %>" method="POST">
                                        <button type="submit" class="bg-green-500 hover:bg-green-600 text-white py-1 px-4 rounded text-sm shadow">
                                            Approve
                                        </button>
                                    </form>
                                    <form action="/admin/payments/decline/<%= request._id %>" method="POST">
                                        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white py-1 px-4 rounded text-sm shadow">
                                            Decline
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </main>

</body>
</html>
