<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loan Applications</title>
    <!-- Add the link to the compiled Tailwind CSS -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.0/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-blue-50 text-gray-900">

    <!-- Back Button -->
    <div class="absolute top-5 right-5">
        <a href="/admin" class="bg-gray-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-opacity-50">
            Back
        </a>
    </div>

    <div class="max-w-7xl mx-auto p-6">
        <h1 class="text-3xl font-bold text-center text-blue-700 mb-6">Loan Requests</h1>

        <!-- Flash Messages -->
        <% if (successMessage && successMessage.length > 0) { %>
            <div class="mb-4 p-4 text-sm text-green-700 bg-green-100 rounded-lg" role="alert">
                <%= successMessage %>
            </div>
        <% } %>

        <% if (errorMessage && errorMessage.length > 0) { %>
            <div class="mb-4 p-4 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
                <%= errorMessage %>
            </div>
        <% } %>

        <!-- Loan Application Table -->
        <div class="overflow-x-auto bg-white shadow-md rounded-lg">
            <table class="w-full table-auto border-collapse border border-blue-200">
                <thead class="bg-blue-100">
                    <tr>
                        <th class="px-4 py-2 border text-left text-sm font-semibold text-blue-700">Student Name</th>
                        <th class="px-4 py-2 border text-left text-sm font-semibold text-blue-700">College Name</th>
                        <th class="px-4 py-2 border text-left text-sm font-semibold text-blue-700">Grade</th>
                        <th class="px-4 py-2 border text-left text-sm font-semibold text-blue-700">Loan Amount</th>
                        <th class="px-4 py-2 border text-left text-sm font-semibold text-blue-700">EMI Plan (Years)</th>
                        <th class="px-4 py-2 border text-left text-sm font-semibold text-blue-700">Total Cost</th>
                        <th class="px-4 py-2 border text-left text-sm font-semibold text-blue-700">Monthly EMI</th>
                        <th class="px-4 py-2 border text-left text-sm font-semibold text-blue-700">Actions</th>
                        <th class="px-4 py-2 border text-left text-sm font-semibold text-blue-700">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% loans.forEach(loan => { %>
                        <tr class="hover:bg-blue-50">
                            <td class="px-4 py-2 border text-sm"><%= loan.studentName %></td>
                            <td class="px-4 py-2 border text-sm"><%= loan.collegeName %></td>
                            <td class="px-4 py-2 border text-sm"><%= loan.grade %></td>
                            <td class="px-4 py-2 border text-sm"><%= loan.amount %></td>
                            <td class="px-4 py-2 border text-sm"><%= loan.emiPlan %></td>
                            <td class="px-4 py-2 border text-sm"><%= loan.totalCost %></td>
                            <td class="px-4 py-2 border text-sm"><%= loan.monthlyEMI %></td>
                            <td class="px-4 py-2 border text-sm">
                                <a href="/admin/loans/approve/<%= loan._id %>" class="inline-block px-4 py-2 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700">Approve</a>
                                <a href="/admin/loans/decline/<%= loan._id %>" class="inline-block px-4 py-2 bg-red-600 text-white font-semibold rounded-md hover:bg-red-700 ml-2">Decline</a>
                            </td>
                            <td class="px-4 py-2 border text-sm">
                                <!-- Display loan status -->
                                <span class="px-2 py-1 inline-block rounded-full 
                                    <%= loan.status === 'Approved' ? 'bg-green-500 text-white' : 
                                        loan.status === 'Declined' ? 'bg-red-500 text-white' : 'bg-yellow-500 text-white' %>">
                                    <%= loan.status || 'Pending' %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <script src="../keepAlive.js"></script>
</body>
</html>
