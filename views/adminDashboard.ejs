<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.0/dist/tailwind.min.css" rel="stylesheet">
    <title>Admin Dashboard</title>
    <style>
        body {
    font-family: 'Poppins', sans-serif;
        }
        .card {
            background-color: #c31432;
            color: white;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            font-weight: bold;
        }
        .red-text {
            color: #c31432;
        }
    </style>
</head>
<body class="bg-gray-100 text-gray-900">

    <!-- Top Navigation -->
    <nav class="bg-white shadow-md py-4">
        <div class="container mx-auto px-6 flex justify-between items-center">
            <h1 class="text-2xl font-bold text-gray-800 red-text">Logo</h1>
            <div class="flex space-x-4 items-center">
                <a href="/admin/users" class="text-gray-700 hover:text-red-600 font-medium">View Users</a>
                <span class="text-gray-300">|</span>
                <a href="/admin/loans" class="text-gray-700 hover:text-red-600 font-medium">Loan Requests</a>
                <span class="text-gray-300">|</span>
                <a href="/admin/loans/approve" class="text-gray-700 hover:text-red-600 font-medium">Approved Loans</a>
                <span class="text-gray-300">|</span>
                <a href="/admin/loans/decline" class="text-gray-700 hover:text-red-600 font-medium">Declined Loans</a>
                <span class="text-gray-300">|</span>
                <a href="/admin/payment-requests" class="text-gray-700 hover:text-red-600 font-medium">Payment Requests</a>
            </div>

            <!-- View Users & Logout Box -->
            <div class="rounded-md flex items-center space-x-4 bg-gray-50">
                
               
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="bg-red-500 hover:bg-red-600 text-white text-sm font-medium py-2 px-4 rounded shadow transition">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mx-auto px-6 py-12">
        <div class="text-center">
            <h1 class="text-3xl font-bold red-text mb-2">Welcome to the Admin Panel!</h1>
            <p class="text-lg mb-8">Manage users, loans, and payments efficiently from one place.</p>
        </div>
        <div class="bg-white rounded-lg shadow-lg p-8 max-w-md mx-auto text-center card">
            <h3 class="text-xl font-semibold ">Total Users</h3>
            <p class="text-5xl font-extrabold mt-2 "><%= totalUsers %></p>
        </div>
    </main>

    <script src="../keepAlive.js"></script>
</body>
</html>
