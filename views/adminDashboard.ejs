<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.0/dist/tailwind.min.css" rel="stylesheet">
    <title>Admin Dashboard</title>
</head>
<body class="bg-gray-50 text-gray-800">

    <!-- Top Navigation -->
    <nav class="bg-white shadow-sm">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <h1 class="text-xl font-semibold text-gray-800">Admin Dashboard</h1>
            <div class="space-x-4">
                <a href="/admin/users" class="bg-blue-500 hover:bg-blue-600 text-white text-sm font-medium py-2 px-4 rounded shadow transition">
                    View Users
                </a>
                <form action="/admin/logout" method="POST" class="inline">
                    <button type="submit" class="bg-red-500 hover:bg-red-600 text-white text-sm font-medium py-2 px-4 rounded shadow transition">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mx-auto px-6 py-10">
        <h2 class="text-2xl font-semibold text-gray-700 mb-6">Overview</h2>

        <!-- Total Users Section -->
        <div class="flex justify-center mb-8">
            <div class="bg-gradient-to-r from-indigo-600 to-indigo-400 text-white rounded-lg shadow-lg p-6 w-full max-w-sm">
                <div class="text-center">
                    <h3 class="text-lg font-medium">Total Users</h3>
                    <p class="text-4xl font-bold mt-3"><%= totalUsers %></p>
                </div>
            </div>
        </div>

        <!-- Cards Section -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Loan Requests Card -->
            <div class="bg-gradient-to-r from-green-500 to-green-400 text-white rounded-lg shadow-lg p-6">
                <h3 class="text-lg font-medium">Loan Requests</h3>
                <form action="/admin/loans" method="GET" class="mt-4">
                    <button type="submit" class="bg-white text-green-600 font-medium py-2 px-4 rounded transition hover:bg-green-100 w-full">
                        View Details
                    </button>
                </form>
            </div>

            <!-- Approved Loans Card -->
            <div class="bg-gradient-to-r from-yellow-500 to-yellow-400 text-white rounded-lg shadow-lg p-6">
                <h3 class="text-lg font-medium">Approved Loans</h3>
                <a href="/admin/loans/approve" class="block mt-4 bg-white text-yellow-600 font-medium py-2 px-4 rounded transition hover:bg-yellow-100 text-center">
                    View Details
                </a>
            </div>

            <!-- Declined Loans Card -->
            <div class="bg-gradient-to-r from-gray-500 to-gray-400 text-white rounded-lg shadow-lg p-6">
                <h3 class="text-lg font-medium">Declined Loans</h3>
                <a href="/admin/loans/decline" class="block mt-4 bg-white text-gray-600 font-medium py-2 px-4 rounded transition hover:bg-gray-100 text-center">
                    View Details
                </a>
            </div>

            <!-- Payment Requests Card -->
            <div class="bg-gradient-to-r from-purple-500 to-purple-400 text-white rounded-lg shadow-lg p-6">
                <h3 class="text-lg font-medium">Payment Requests</h3>
                <a href="/admin/payment-requests" class="block mt-4 bg-white text-purple-600 font-medium py-2 px-4 rounded transition hover:bg-purple-100 text-center">
                    View Details
                </a>
            </div>
        </div>
    </main>

    <script src="../keepAlive.js"></script>
</body>
</html>
