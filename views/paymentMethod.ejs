<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.0.0/dist/tailwind.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cantora+One&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cantora+One&display=swap" rel="stylesheet">
    <title>Payment Method</title>
    <style>
        body {
            font-family: "Roboto", serif;
        }
        .cantora-one-regular {
        font-family: "Cantora One", serif;
        font-weight: 600;
        font-style: normal;
        } 
        .color {
            color: #c31432;
        }
        .bg-color {
            background-color: #c31432;
        }
        /* Custom Radio Button Style */
        input[type="radio"] {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            width: 20px;
            height: 20px;
            border: 2px solid #cbd5e0;
            border-radius: 50%;
            background-color: #fff;
            position: relative;
            transition: all 0.3s ease;
        }

        input[type="radio"]:checked {
            border-color: #c31432;
            background-color: #c31432;
        }

        input[type="radio"]:checked::before {
            content: '';
            position: absolute;
            top: 4px;
            left: 4px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: #fff;
        }

        input[type="radio"]:hover {
            border-color: #c31432;
        }

        label {
            cursor: pointer;
            font-size: 1.125rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            padding: 0.5rem;
            transition: color 0.3s;
        }

        input:focus , textarea:focus {
            border-color: #d3a3a9;
            border-width: 1.5px;  /* Ensures the border is visible */
            outline: none;  /* Removes the default blue outline */
        }

        label span {
            margin-left: 0.5rem;
        }
    </style>
</head>
<body class="bg-gray-100 flex flex-col items-center">
    <nav class="bg-color text-white py-4 text-center max-w-lg mx-auto w-full px-6  ">
        <div class="text-lg font-medium">
            <div class="flex items-center justify-center space-x-2">
                <div class="rounded-full border-2 border-white-500 p-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 12c2.485 0 4.5-2.015 4.5-4.5S14.485 3 12 3 7.5 5.015 7.5 7.5 9.515 12 12 12zM4.5 21c0-4.142 3.358-7.5 7.5-7.5s7.5 3.358 7.5 7.5H4.5z" />
                    </svg>
                </div>
                <p class="text-2xl"><%= name %></p>
            </div>
            <span class="text-lg">Welcome onboard!</span>
        </div>
    </nav>

    <div class="container p-4 bg-white rounded-lg shadow-md max-w-lg w-full">
        <h3 class="text-2xl cantora-one-regular font-bold color mb-4 text-center">Select Payment Method</h3>
        <div class="flex flex-col space-y-4">
            <div class="flex items-center">
                <input type="radio" id="bank-transfer" name="payment-method" value="bank-transfer">
                <label for="bank-transfer">
                    <span>Bank Transfer</span>
                </label>
            </div>
            <div class="flex items-center">
                <input type="radio" id="collect-cash" name="payment-method" value="collect-cash">
                <label for="collect-cash">
                    <span>Collect Cash</span>
                </label>
            </div>
        </div>
    </div>

    <form id="bank-transfer-form" class="mt-6 p-4 bg-white rounded-lg shadow-lg hidden max-w-lg w-full" action="/user/pay-method" method="POST">
        <div class="space-y-4 mb-10">
            <div class="flex justify-between items-center">
                <label for="account-holder" class="block font-medium w-1/2">Name:</label>
                <p class="w-1/2 p-3 mt-2 bg-gray-100 rounded-lg font-medium">Payoman</p>
            </div>
            <div class="flex justify-between items-center">
                <label for="account-no" class="block font-medium w-1/2">Account Number:</label>
                <p class="w-1/2 p-3 mt-2 bg-gray-100 rounded-lg font-medium">1234567890</p>
            </div>
            <div class="flex justify-between items-center">
                <label for="swift-code" class="block font-medium w-1/2">SWIFT Code:</label>
                <p class="w-1/2 p-3 mt-2 bg-gray-100 rounded-lg font-medium">SWIFT12345</p>
            </div>
            <div class="flex justify-between items-center">
                <label for="branch" class="block font-medium w-1/2">Branch:</label>
                <p class="w-1/2 p-3 mt-2 bg-gray-100 rounded-lg font-medium">Main Branch</p>
            </div>
        </div>
        <h3 class="text-xl cantora-one-regular  font-bold color mb-1 text-center">Bank Transfer Details</h3>
        <input type="hidden" name="paymentMethod" value="Bank Transfer">
        <input type="hidden" name="loanId" value="<%= loan._id %>">
        <div class="space-y-4">
            <div class="flex flex-col">
                <label class="block font-medium">Bank Name:</label>
                <input type="text" name="bankName" class="w-full p-2 bg-gray-100 rounded-lg" placeholder="Enter Bank Name" required>
            </div>
            <div class="flex flex-col">
                <label class="block font-medium">Amount:</label>
                <input type="text" name="amount" class="w-full p-2 bg-gray-100 rounded-lg" value="<%= amountDue %>" readonly>
            </div>
            <div class="flex flex-col">
                <label class="block font-medium">Reference No.:</label>
                <input type="text" name="referenceNo" class="w-full p-2 bg-gray-100 rounded-lg" placeholder="Enter Reference Number" required>
            </div>
            <div class="text-center">
                <button type="submit" class="bg-color text-white px-6 py-2 rounded hover:bg-red-700">Proceed</button>
            </div>
        </div>
    </form>

    <form id="collect-cash-form" class="mt-6 p-4 bg-white rounded-lg shadow-lg hidden max-w-lg w-full" action="/user/pay-method" method="POST">
        <h3 class="text-xl cantora-one-regular  font-bold color mb-4 text-center">Cash Payment</h3>
        <input type="hidden" name="paymentMethod" value="Collect Cash">
        <input type="hidden" name="loanId" value="<%= loan._id %>">
        <div class="space-y-4">
            <div class="flex flex-col">
                <label class="block font-medium">Name:</label>
                <input type="text" name="name" class="w-full p-2 bg-gray-100 rounded-lg" value="<%= name %>" readonly>
            </div>
            <div class="flex flex-col">
                <label class="block font-medium">Amount:</label>
                <input type="text" name="amount" class="w-full p-2 bg-gray-100 rounded-lg" value="<%= amountDue %>" readonly>
            </div>
            <div class="flex flex-col">
                <label class="block font-medium">Address:</label>
                <textarea name="address" class="w-full p-2 bg-gray-100 rounded-lg resize-none" placeholder="Enter Address" required rows="4"></textarea>

            </div>
            <div class="text-center">
                <p class="mb-2 text-sm text-gray-600">Additional Charge Will be Applied for Cash Payment.</p>
                <button type="submit" class="bg-color text-white px-4 py-2 rounded hover:bg-red-700">Proceed</button>
            </div>
        </div>
    </form>

    <script>
        const bankTransferRadio = document.getElementById('bank-transfer');
        const collectCashRadio = document.getElementById('collect-cash');
        const bankTransferForm = document.getElementById('bank-transfer-form');
        const collectCashForm = document.getElementById('collect-cash-form');

        bankTransferRadio.addEventListener('change', function() {
            if (this.checked) {
                bankTransferForm.classList.remove('hidden');
                collectCashForm.classList.add('hidden');
            }
        });

        collectCashRadio.addEventListener('change', function() {
            if (this.checked) {
                collectCashForm.classList.remove('hidden');
                bankTransferForm.classList.add('hidden');
            }
        });
    </script>
</body>
</html>
